-  },
-  &quot;entries&quot;: [
-    {
-      &quot;identifier&quot;: &quot;urn:air:anonymous.modelcontextprotocol.io:mcp:brave-search&quot;,
-      &quot;version&quot;: &quot;1.0.2&quot;,
