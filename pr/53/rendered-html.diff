-      &quot;url&quot;: &quot;https://registry.modelcontextprotocol.io/servers/brave-search/server.json&quot;,
-      &quot;description&quot;: &quot;MCP server for Brave Search API integration&quot;,
-      &quot;tags&quot;: [&quot;search&quot;, &quot;brave&quot;]
-    },
-    {
