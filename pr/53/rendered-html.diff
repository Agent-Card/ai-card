-      &quot;version&quot;: &quot;1.0.2&quot;,
-      &quot;type&quot;: &quot;application/mcp-server-card+json&quot;,
-      &quot;url&quot;: &quot;https://registry.modelcontextprotocol.io/servers/filesystem/server.json&quot;,
-      &quot;description&quot;: &quot;MCP server for filesystem operations&quot;,
