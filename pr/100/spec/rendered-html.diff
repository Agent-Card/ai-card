-      &quot;mediaType&quot;: &quot;application/vnd.oci.image.manifest.v1+json&quot;,
-      &quot;digest&quot;: &quot;sha256:aaa111...&quot;,
-      &quot;size&quot;: 1024,
-      &quot;artifactType&quot;: &quot;application/a2a-agent-card+json&quot;,
